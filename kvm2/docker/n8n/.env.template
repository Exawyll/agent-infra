# ===== VARIABLES OBLIGATOIRES =====
DOMAIN_NAME=example.com
SUBDOMAIN=n8n
SSL_EMAIL=admin@example.com
GENERIC_TIMEZONE=Europe/Berlin
N8N_ENCRYPTION_KEY=CHANGE_ME

# ===== VARIABLES OPTIONNELLES (projets) =====
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
GITHUB_REPO=
NOTION_TOKEN=
NOTION_BACKLOG_DB=
NOTION_STATE_DB=
NOTION_DECISIONS_DB=
PO_EMAIL=

# ===== Symphony Phase 1 — déjà en prod, absent ici par dérive constatée =====
LINEAR_WEBHOOK_SECRET=

# ===== Symphony Phase 2 (orchestrateur) =====
# Écriture Linear (transitions d'état + commentaires) — distincte de LINEAR_WEBHOOK_SECRET
# ci-dessus, qui ne sert qu'à vérifier la signature HMAC entrante.
LINEAR_API_KEY=
# ID réel de l'équipe Linear "agent-infra" (workspace Workspace_exaw_perso) — pas un secret,
# confirmé via l'API le 2026-07-19. Vérifier qu'il n'a pas changé si le workspace est recréé.
LINEAR_TEAM_ID=5a56d2e1-f93a-41ba-bdfd-30ce053039a8
# Noms réels des states/labels sur le board "agent-infra" — le board n'a PAS les 5 states
# SPEC.md (Triage/Ready/In Progress/In Review/Rejected) mais seulement Backlog/Todo/In
# Progress/Done/Duplicate/Canceled (confirmé via l'API le 2026-07-19). Remapping retenu
# (décision utilisateur, pas de nouveaux states créés) : Backlog=Triage, Todo=Ready,
# In Progress/Done natifs inchangés. Pas d'état "In Review" : le ticket reste In Progress
# jusqu'au merge, symphony-merge-handler transitionne directement vers Done.
LINEAR_STATE_READY=Todo
LINEAR_STATE_IN_PROGRESS=In Progress
LINEAR_STATE_TRIAGE=Backlog
LINEAR_STATE_DONE=Done
LINEAR_LABEL_AGENT_OK=agent:ok
# Labels réels du board (confirmés via l'API) : bug/evolution/docs, en minuscules.
LINEAR_TYPE_LABELS=bug,evolution,docs
# HMAC du webhook GitHub pull_request → symphony-merge-handler
GITHUB_WEBHOOK_SECRET=
# Clé virtuelle LiteLLM dédiée aux runs d'agent (budget propre) — jamais une clé Anthropic directe,
# cf. doctrine "LiteLLM routeur unique" dans SPEC.md.
LITELLM_AGENT_DEV_KEY=
# Accessible en interne via le réseau Docker du stack (service `litellm`) — pas besoin de Tailscale
# pour les appels n8n->LiteLLM, contrairement au runner GitHub Actions externe.
LITELLM_INTERNAL_URL=http://litellm:4000
RUN_TIMEOUT_MIN=45
RUN_BUDGET_USD=20
# Secret HMAC du rapport de fin de run GitHub Actions -> webhook n8n run-dev-report
RUN_DEV_REPORT_SECRET=
# Secret du webhook Hermes dev (platforms.webhook, cf. kvm2/hermes/profiles/dev/config.yaml)
# utilisé par symphony-watchdog pour les alertes Telegram de timeout/budget.
HERMES_DEV_WEBHOOK_SECRET=
