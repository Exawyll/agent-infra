{
  "name": "trigger-actus-positives",
  "active": true,
  "nodes": [
    {
      "id": "schedule-1",
      "name": "Schedule 6h UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [0, 0],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 6"
            }
          ]
        }
      }
    },
    {
      "id": "read-file-1",
      "name": "Read dedup log",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [300, 0],
      "parameters": {
        "fileOperation": "read",
        "fileSelector": "/files/factfulness_log.json"
      }
    },
    {
      "id": "parse-dedup-1",
      "name": "Parse dedup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 0],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "try {\n  const fileData = $input.first().json.data;\n  const entries = fileData ? (JSON.parse(fileData).entries || []) : [];\n  const crypto = require('crypto');\n  const body = JSON.stringify({ dedup_log: entries });\n  const signature = 'sha256=' + crypto.createHmac('sha256', $env.WEBHOOK_SECRET || '').update(body).digest('hex');\n  const res = await this.helpers.httpRequest({\n    method: 'POST',\n    url: 'http://172.18.0.1:8644/webhooks/factfulness-daily',\n    headers: { 'Content-Type': 'application/json', 'X-Hub-Signature-256': signature },\n    body\n  });\n  return [{ json: { statusCode: (res && res.statusCode) || 200 } }];\n} catch (e) {\n  return [{ json: { statusCode: (e && (e.statusCode || (e.response && e.response.status))) || 500, error: e.message || String(e) } }];\n}"
      }
    },
    {
      "id": "if-1",
      "name": "Erreur ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [900, 0],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "status-err",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 400,
              "operator": {
                "type": "number",
                "operation": "largerEqual"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "tg-1",
      "name": "Alerte Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 2,
      "position": [1200, 100],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "8262789577",
        "text": "=🚨 *ÉCHEC — Actus Positives*\n\nLe webhook Hermes `factfulness-daily` n'a pas répondu.\n\n- Statut HTTP : `{{ $json.statusCode }}`\n- Erreur : {{ $json.error || 'pas de détail' }}\n- Horodatage : {{ $now }}"
      },
      "credentials": {
        "telegramApi": {
          "id": "ihZuIM3ZQcKsWsu9",
          "name": "Telegram account"
        }
      }
    }
  ],
  "connections": {
    "Schedule 6h UTC": {
      "main": [
        [
          {
            "node": "Read dedup log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read dedup log": {
      "main": [
        [
          {
            "node": "Parse dedup",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse dedup": {
      "main": [
        [
          {
            "node": "Erreur ?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Erreur ?": {
      "main": [
        [
          {
            "node": "Alerte Telegram",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
