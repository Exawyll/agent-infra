    {
      "parameters": {
        "jsCode": "const inboxRaw = $input.first().json?.results || [];\n\nconst getTitle = (page, propName) => {\n  const p = page.properties?.[propName];\n  if (!p) return '';\n  if (p.title) return p.title.map(t => t.plain_text).join('');\n  return '';\n};\n\nconst getSelect = (page, propName) =>\n  page.properties?.[propName]?.select?.name || '';\n\nconst getRichText = (page, propName) => {\n  const p = page.properties?.[propName]?.rich_text;\n  if (!p) return '';\n  return p.map(t => t.plain_text).join('').slice(0, 300);\n};\n\nconst inbox = inboxRaw.map(p => ({\n  id: p.id,\n  titre: getTitle(p, 'Capture'),\n  action: getSelect(p, 'Action'),\n  confiance: getSelect(p, 'Confiance'),\n  source: getSelect(p, 'Source'),\n  notes: getRichText(p, 'Notes'),\n  lien_source: p.properties?.['Lien Source']?.url || ''\n}));\n\nreturn [{\n  json: {\n    date: $('Compute dates').item.json.today,\n    generated_at: new Date().toISOString(),\n    stats: {\n      nb_inbox: inbox.length,\n      nb_a_verifier: inbox.filter(i => i.confiance === '🟡 À vérifier').length,\n      nb_faire: inbox.filter(i => i.action === '➡️ Faire').length\n    },\n    inbox\n  }\n}];"
      },
