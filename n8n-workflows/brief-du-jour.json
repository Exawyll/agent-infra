    {
      "parameters": {
        "jsCode": "// Calcul des dates en ISO (fuseau Europe/Paris)\nconst now = new Date();\nconst tzOffset = 2 * 60 * 60 * 1000; // ajuster si hiver (1h)\nconst paris = new Date(now.getTime() + tzOffset);\n\nconst yyyy = paris.getUTCFullYear();\nconst mm = String(paris.getUTCMonth() + 1).padStart(2, '0');\nconst dd = String(paris.getUTCDate()).padStart(2, '0');\n\nconst today = `${yyyy}-${mm}-${dd}`;\nconst startOfDay = `${today}T00:00:00.000+02:00`;\nconst endOfDay = `${today}T23:59:59.999+02:00`;\n\nreturn [{\n  json: {\n    today,\n    startOfDay,\n    endOfDay\n  }\n}];"
      },
