    {
      "parameters": {
        "jsCode": "// Construit le payload Notion pour remplacer le contenu de la page Brief\nconst data = $json;\n\nconst blocks = [];\n\n// Header\nblocks.push({\n  object: 'block',\n  type: 'heading_1',\n  heading_1: {\n    rich_text: [{ type: 'text', text: { content: `Brief du ${data.date}` } }]\n  }\n});\n\nblocks.push({\n  object: 'block',\n  type: 'paragraph',\n  paragraph: {\n    rich_text: [{\n      type: 'text',\n      text: { content: `Généré à ${new Date(data.generated_at).toLocaleTimeString('fr-FR')} — ${data.stats.nb_inbox} inbox à traiter — ${data.stats.nb_faire} ➡️ Faire, ${data.stats.nb_a_verifier} 🟡 À vérifier` },\n      annotations: { italic: true, color: 'gray' }\n    }]\n  }\n});\n\n// Payload JSON brut en code block (Claude lira ça)\nblocks.push({\n  object: 'block',\n  type: 'heading_2',\n  heading_2: { rich_text: [{ type: 'text', text: { content: 'Data JSON (pour Claude)' } }] }\n});\n\nconst jsonStr = JSON.stringify(data, null, 2);\n// Notion limite code block à 2000 chars par rich_text, on split si besoin\nconst chunks = [];\nfor (let i = 0; i < jsonStr.length; i += 1900) {\n  chunks.push(jsonStr.slice(i, i + 1900));\n}\n\nblocks.push({\n  object: 'block',\n  type: 'code',\n  code: {\n    language: 'json',\n    rich_text: chunks.map(c => ({ type: 'text', text: { content: c } }))\n  }\n});\n\nreturn [{ json: { blocks, page_data: data } }];"
      },
