  "name": "Outlook → Notion Calendar Sync",
  "description": null,
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "jsCode": "// L'entrée réelle : body.event.bodyPreview est une STRING JSON à parser\nconst input = $input.first().json;\nconst eventWrapper = input.body?.event ?? input.event ?? input;\nconst raw = eventWrapper.bodyPreview ?? eventWrapper.body ?? eventWrapper;\nconst e = typeof raw === 'string' ? JSON.parse(raw) : raw;\n\n// 🛑 Guard : ignorer les événements sans titre réel\nconst subject = e.subject || '';\nif (subject.trim() === 'Nouvel événement') {\n  return []; // Stoppe le flux — aucune donnée sortante\n}\n\nconst stripHtml = s => (s || '').replace(/<[^>]*>/g, '').trim().slice(0, 2000);\n\nconst catMap = {\n  'MyKinexo': '🔵 MyKinexo',\n  'Ediflux':  '🟠 Ediflux',\n  'CODIR':    '🟣 CODIR',\n  'Formation':'🟡 Formation',\n  'Perso':    '⚫ Perso'\n};\nconst cats = Array.isArray(e.categories) ? e.categories : [];\nconst matchedCat = cats.find(c => catMap[c]);\nconst categorie = matchedCat ? catMap[matchedCat] : '⚪ Autre';\n\nconst isRecurring = (e.recurrence || 'none') !== 'none';\n\nconst action = (e.ActionType || '').toLowerCase();\nconst responseType = (e.responseType || '').toLowerCase();\n\n// Outlook ne renvoie jamais \"deleted\" — une suppression/refus arrive comme \"updated\" avec responseType \"declined\"\nconst isDeleted = action === 'deleted' || responseType === 'declined';\nconst effectiveAction = isDeleted ? 'deleted' : action;\n\nlet statutSync;\nif (isDeleted)              { statutSync = '🗑️ Supprimé'; }\nelse if (action === 'updated') { statutSync = '🔄 Modifié'; }\nelse                           { statutSync = '✅ Actif'; }\n\nreturn [{\n  json: {\n    actionType: effectiveAction,\n    iCalUId:      e.iCalUId || '',\n    subject:      e.subject || '(sans titre)',\n    start:        e.startWithTimeZone || e.start || '',\n    end:          e.endWithTimeZone   || e.end   || '',\n    isAllDay:     e.isAllDay === true,\n    organizer:    e.organizer || '',\n    participants: [e.requiredAttendees, e.optionalAttendees].filter(Boolean).join(', '),\n    location:     e.location || e.webLink || '',\n    body:         stripHtml(e.body),\n    recurrence:   e.recurrence || 'none',\n    isRecurring,\n    lastModified: e.lastModifiedDateTime || new Date().toISOString(),\n    now:          new Date().toISOString(),\n    categorie,\n    statutSync,\n    statutActif:  '✅ Actif'\n  }\n}];"
      },
