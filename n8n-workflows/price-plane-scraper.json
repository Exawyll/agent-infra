    {
      "parameters": {
        "jsCode": "// R\u00e9cup\u00e9ration des donn\u00e9es du webhook\nconst data = $input.first().json;\n\n// Formatage pour l'email\nconst subject = `\ud83c\udfaf Vol Paris-Bangkok : ${data.current_price}\u20ac (${data.delta_amount}\u20ac / ${data.delta_percent}%)`;\n\nconst body = `\nAlerte prix d\u00e9tect\u00e9e ! \ud83d\udea8\n\n\ud83d\udcca D\u00e9tails du prix :\n- Prix actuel : ${data.current_price}\u20ac\n- Prix pr\u00e9c\u00e9dent : ${data.previous_price}\u20ac\n- \u00c9conomie : ${Math.abs(data.delta_amount)}\u20ac (${Math.abs(data.delta_percent)}%)\n\n\u2708\ufe0f D\u00e9tails du vol :\n- Compagnie : ${data.flight_details?.airline || 'N/A'}\n- D\u00e9part : ${data.flight_details?.departure_date || 'N/A'}\n- Retour : ${data.flight_details?.return_date || 'N/A'}\n- Dur\u00e9e : ${data.flight_details?.duration || 'N/A'}\n- Horaires : ${data.flight_details?.times || 'N/A'}\n\n\ud83d\udd17 Lien direct :\n${data.link}\n\n---\nScraping effectu\u00e9 le : ${new Date().toLocaleString('fr-FR')}\n`;\n\nreturn {\n  json: {\n    subject: subject,\n    body: body,\n    to: 'wylliam.delaunay@gmail.com'\n  }\n};"
      },
