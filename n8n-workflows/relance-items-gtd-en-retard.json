    {
      "id": "682c3034-7da4-4b18-9120-8d5d6e5d5cfb",
      "name": "Filtrer et formater",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        -400
      ],
      "parameters": {
        "jsCode": "const results = $input.item.json.results || [];\nconst now = new Date();\nconst sevenDaysAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\n\nconst overdue = results.filter(function(page) {\n  const props = page.properties;\n  if (!props) return false;\n  const action = props['Action'] && props['Action'].select ? props['Action'].select.name : '';\n  const traite = props['Trait\u00e9'] ? props['Trait\u00e9'].checkbox : false;\n  const dateCapture = new Date(props['Date Capture'] ? props['Date Capture'].created_time : page.created_time);\n  return action === '\\u27A1\\uFE0F Faire' && !traite && dateCapture < sevenDaysAgo;\n});\n\nif (overdue.length === 0) {\n  return [{ json: { count: 0, lines: 'Aucun item en retard cette semaine.' } }];\n}\n\nconst lines = overdue.map(function(page) {\n  const props = page.properties;\n  const titre = props['Capture'] && props['Capture'].title ? props['Capture'].title.map(function(t) { return t.plain_text; }).join('') : 'Sans titre';\n  const dateCapture = new Date(props['Date Capture'] ? props['Date Capture'].created_time : page.created_time);\n  const ageDays = Math.floor((now - dateCapture) / (1000 * 60 * 60 * 24));\n  return '\u2022 ' + titre + ' (J+' + ageDays + ')';\n});\n\nconst dateStr = now.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric' });\nconst summary = dateStr + ' \\u2014 ' + overdue.length + ' action(s) Faire en attente depuis +7j :\\n\\n' + lines.join('\\n');\n\nreturn [{ json: { count: overdue.length, lines: summary } }];"
      }
    },
