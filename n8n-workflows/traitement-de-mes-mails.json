      ],
      "parameters": {
        "jsCode": "const raw = $input.item.json.output?.text \n  ?? $input.item.json.text \n  ?? JSON.stringify($input.item.json);\n\nconst cleaned = raw\n  .replace(/```json\\n?/gi, \"\")\n  .replace(/```\\n?/g, \"\")\n  .trim();\n\nreturn { json: { output: JSON.parse(cleaned) } };"
      }
